# Example Mother configuration
# Copy to ~/.config/mother/config.toml and adjust values.

model = "gpt-5"
tools_enabled = true
reasoning_effort = "medium"
openai_reasoning_summary = "auto"

# Theme selection. "auto" follows your terminal/system light or dark appearance.
# theme = "auto"
# theme_dark = "catppuccin-mocha"
# theme_light = "catppuccin-latte"

# Key bindings. Every Mother action can be remapped under [keybindings].
# Defaults are Enter to submit and Shift+Enter for newline. See KEYBINDINGS.md
# for the full list of binding ids.
# [keybindings]
# submit = "ctrl+enter"
# newline = "enter"
# toggle_auto_scroll = "ctrl+g"

[[models]]
id = "gpt-5"
name = "gpt-5"
api_type = "openai-responses"
api_key_env = "OPENAI_API_KEY"
supports_tools = true
supports_reasoning = true
supports_images = true

# Optional per-model PydanticAI request settings. For ds4-server with DSpark:
# model_settings = { temperature = 0, top_p = 1 }

# Optional per-model reasoning-effort mapping for providers that do not accept
# every level Mother exposes (Mother's equivalent of Pi's thinkingLevelMap):
# reasoning_effort_map = { low = "low", medium = "high", high = "high", xhigh = "xhigh" }

# Optional: council setup
# [council]
# members = ["gpt-5"]
# judge = "gpt-5"
# max_context_turns = 8
# max_context_chars = 12000
