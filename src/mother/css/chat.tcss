#main-pane {
    margin: 0;
    background: $background;
}

#chat-view {
    border: none;
    margin: 0;
    padding: 0 1;
    background: transparent;
}

WelcomeBanner {
    width: 100%;
    height: auto;
    margin: 0 0 1 0;
    padding: 1 0 0 0;
    color: $success;
    background: transparent;
    text-align: center;
    text-style: bold;
    text-wrap: nowrap;
}

ConversationTurn {
    height: auto;
    margin: 0;
    border: none;
    background: transparent;
}

.turn-section {
    height: auto;
    width: 100%;
    margin: 0;
    border: none;
    background: transparent;
}

.prompt-section {
    border-left: solid $primary 80%;
    background: $surface;
}

.thinking-section {
    border-left: solid $secondary 60%;
    background: $surface 18%;
    color: $text-muted;
}

.response-section {
    border-left: solid $success 55%;
    background: transparent;
}

.tool-trace-stack {
    height: auto;
    width: 100%;
    margin: 0;
    background: transparent;
}

TurnLabel {
    background: transparent;
    text-style: bold;
}

.turn-gutter {
    width: 3;
    min-width: 3;
    height: auto;
    padding: 0 0 0 1;
}

.prompt-gutter,
.input-gutter {
    color: $primary;
}

.thinking-gutter {
    color: $secondary;
}

.turn-title {
    height: 1;
    width: 100%;
    padding: 0 1;
}

.shell-title {
    color: $warning;
    text-style: bold;
}

.tool-title {
    color: $accent;
    text-style: bold;
}

.recovery-title {
    color: $error;
    text-style: bold;
}

.council-title {
    color: $secondary;
    text-style: bold;
}

Prompt.grouped,
Response.grouped,
Prompt,
Response {
    width: 1fr;
    border: none;
    background: transparent;
    color: $foreground;
    margin: 0;
}

Response.response-awaiting {
    color: $success;
    text-style: bold;
}

Response.response-awaiting MarkdownBlock {
    & > .code_inline {
        color: $warning;
        background: transparent;
        text-style: bold;
    }
}

Prompt.grouped,
ThinkingOutput.grouped,
Response.grouped {
    background: transparent;
}

Prompt.grouped,
ThinkingOutput.grouped {
    padding: 0 1 0 1;
}

Response.grouped,
Prompt,
Response {
    padding: 0 1;
}

Response.grouped:focus,
ThinkingOutput.grouped:focus,
Response:focus {
    border: none;
    background: $surface 18%;
}

Prompt > MarkdownBlock:last-child,
Response > MarkdownBlock:last-child {
    margin-bottom: 0;
}

MarkdownBlock.highlight {
    background: $primary 12%;
}

Prompt MarkdownFence,
Response MarkdownFence {
    background: $surface 55%;
    color: $foreground;
    border-left: solid $accent 60%;
}

Prompt MarkdownBlock > .code_inline,
Response MarkdownBlock > .code_inline {
    color: $warning;
    background: $surface 65%;
    text-style: bold;
}
